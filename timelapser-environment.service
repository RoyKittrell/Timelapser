[Unit]
Description=Log Timelapser enclosure temperature and humidity
After=local-fs.target

[Service]
Type=oneshot
User=timelapser
Group=timelapser
WorkingDirectory=/home/timelapser/Timelapser Sept2026/timelapser_v5
ExecStart=/home/timelapser/timelapser-venv/bin/python3 "/home/timelapser/Timelapser Sept2026/timelapser_v5/environment_monitor.py" --log
