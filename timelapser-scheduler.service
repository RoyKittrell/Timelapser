[Unit]
Description=Timelapser V5 Sunrise/Sunset Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roy
WorkingDirectory=/home/roy/timelapser_v5_current
ExecStartPre=/usr/bin/sudo /usr/sbin/uhubctl -l 1-1 -p 4 -a off
ExecStart=/home/roy/timelapser-venv/bin/python3 /home/roy/timelapser_v5_current/timelapser_scheduler.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
