# Verified BCM assignments from the successful intervalometer test.
TIMELAPSER_V6_FOCUS_GPIO=23
TIMELAPSER_V6_SHUTTER_GPIO=24

# Both 5 V relay inputs assert HIGH and must be held LOW while idle.
TIMELAPSER_V6_WAKE_PULSE_SECONDS=0.5
TIMELAPSER_V6_WAKE_SETTLE_SECONDS=2.0
TIMELAPSER_V6_FOCUS_PULSE_SECONDS=2.0
TIMELAPSER_V6_FOCUS_SETTLE_SECONDS=0.75
TIMELAPSER_V6_HALF_PRESS_CLEAR_SECONDS=1.0
TIMELAPSER_V6_SHUTTER_PULSE_SECONDS=0.15
