[Unit]
Description=Timelapser V5 Director Dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=roy
Group=roy
WorkingDirectory=/home/roy/Timelapser Sept2026/timelapser_v5
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/roy/timelapser-venv/bin/streamlit run "/home/roy/Timelapser Sept2026/timelapser_v5/timelapser_director_v5.py" --server.address 0.0.0.0 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
