[Unit]
Description=Timelapser V6 wired mission scheduler
After=network-online.target local-fs.target timelapser-camera-release.service
Wants=network-online.target
Requires=timelapser-camera-release.service

[Service]
Type=simple
User=timelapser
WorkingDirectory=/home/timelapser/Timelapser Sept2026/timelapser_v5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/timelapser/.config/timelapser/v6-hardware.env
ExecStart=/home/timelapser/timelapser-venv/bin/python3 timelapser_scheduler_v6.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

