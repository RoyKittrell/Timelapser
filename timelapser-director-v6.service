[Unit]
Description=Timelapser V6 wired dashboard
After=network-online.target timelapser-camera-release.service
Wants=network-online.target timelapser-camera-release.service

[Service]
Type=simple
User=timelapser
WorkingDirectory=/home/timelapser/Timelapser Sept2026/timelapser_v5
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/timelapser/timelapser-venv/bin/streamlit run timelapser_director_v6.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

